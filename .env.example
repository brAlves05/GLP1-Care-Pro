# GLP-1 Care Pro — Variáveis de ambiente
# Copie para .env e preencha os valores — NUNCA commite o .env

# ── Banco de dados ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/glp1_care_pro?schema=public"

# ── JWT ──────────────────────────────────────────────────────────
JWT_SECRET="min-32-chars-secret-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Servidor ─────────────────────────────────────────────────────
PORT=3000
NODE_ENV="development"

# ── Criptografia ponta a ponta (mensagens) ───────────────────────
# Chave mestre para envelope encryption das chaves de sessão
ENCRYPTION_MASTER_KEY="min-32-chars-key-change-in-production"

# ── Storage (fotos, documentos) ──────────────────────────────────
S3_BUCKET="glp1-care-pro-media"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Expiração das URLs assinadas (segundos)
S3_URL_EXPIRES_IN=3600

# ── Rate limiting ────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ── LGPD ─────────────────────────────────────────────────────────
LGPD_CONSENT_VERSION="1.0.0"
